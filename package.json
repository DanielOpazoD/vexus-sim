{
  "name": "vexus-sim",
  "version": "0.5.0",
  "private": true,
  "description": "Simulador ecográfico VExUS en navegador: paciente virtual → fisiología → anatomía → adquisición → imagen/espectro/audio → medición → clasificación.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsx tools/ci/bundle-budget.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:slow": "VITEST_TIER=slow vitest run --testTimeout=180000",
    "test:all": "VITEST_TIER=all vitest run --testTimeout=180000",
    "test:watch": "vitest",
    "calibrate": "tsx tools/calibrate.ts",
    "docs:index": "tsx tools/docs/decisions-index.ts",
    "fidelity": "tsx tools/fidelity/bench.ts",
    "fidelity:blind": "tsx tools/fidelity/blind-pairs.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && vite build && tsx tools/ci/bundle-budget.ts",
    "test:coverage": "npm run test:coverage:core && npm run test:matrix && npm run test:coverage:verify",
    "e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test:coverage:full": "VITEST_TIER=all VITEST_COVERAGE_PARTITION=all vitest run --coverage --testTimeout=180000",
    "test:coverage:core": "node --import tsx tools/ci/run-validation-phase.ts core",
    "test:matrix": "node --import tsx tools/ci/run-validation-phase.ts matrix",
    "test:coverage:verify": "node --import tsx tools/ci/verify-validation.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "^3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
